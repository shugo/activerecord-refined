{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://shugo.github.io",
          "http://localhost:8000"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range"]
      },
      "exposeHeaders": ["content-length", "content-encoding"],
      "maxAgeSeconds": 86400
    }
  ]
}
