#!/bin/bash
#
# Assembles everything the page needs besides ruby.wasm itself:
#
#   rb/lib          the Ruby files written into the WASM filesystem at boot
#   manifest.json   the list the page fetches to know what to write
#   assets/         the browser bundles
#
# None of it is committed.  The gem's own lib comes from the checkout one
# directory up, sqlite3's Ruby files from the bundle, and the browser bundles
# from node_modules.  Only stubs/ and pglite/ are maintained by hand.
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

SQLITE3_GEM=$(bundle show sqlite3 2>/dev/null || true)
if [ -z "$SQLITE3_GEM" ]; then
  echo "sqlite3 gem not found; run 'bundle install' first" >&2
  exit 1
fi

rm -rf rb
mkdir -p rb/lib

cp -r ../lib/. rb/lib/
cp -r "$SQLITE3_GEM"/lib/. rb/lib/
cp -r stubs/. rb/lib/
cp -r pglite/. rb/lib/

# A .so from the host build of the gem would be copied along with the .rb files.
find rb/lib -name '*.so' -delete

ruby -rjson -e '
  files = Dir.glob("rb/lib/**/*.rb").map { |p| p.delete_prefix("rb/lib/") }.sort
  File.write("manifest.json", JSON.pretty_generate(files) + "\n")
  puts "#{files.size} Ruby files"
'

BUNDLE=node_modules/@ruby/wasm-wasi/dist/browser.umd.js
if [ ! -f "$BUNDLE" ]; then
  echo "$BUNDLE not found; run 'npm ci' first" >&2
  exit 1
fi
mkdir -p assets
cp "$BUNDLE" assets/

# CodeMirror is a dozen ESM packages with bare specifiers between them, so it
# has to be bundled before a page can load it.
npx esbuild src/editor.js \
  --bundle --format=esm --minify \
  --outfile=assets/editor.js \
  --log-level=warning
echo "$(du -h assets/editor.js | cut -f1) assets/editor.js"

# PGlite is not assembled here at all: the pages import it from jsDelivr when
# they are switched to PostgreSQL.  What is checked is that the version they
# name is the version npm installed, since that second one is what
# check-examples runs against and nothing else would notice them parting.
PGLITE_PACKAGE=node_modules/@electric-sql/pglite/package.json
if [ ! -f "$PGLITE_PACKAGE" ]; then
  echo "$PGLITE_PACKAGE not found; run 'npm ci' first" >&2
  exit 1
fi

installed=$(node -p "require('./$PGLITE_PACKAGE').version")
# Both pages name it, so this is a set: more than one version left in it is a
# disagreement of its own and fails the comparison below.
in_pages=$(sed -n 's|.*<meta name="pglite"[^>]*pglite@\([^/]*\)/.*|\1|p' \
             index.html browser-check.html | sort -u | tr '\n' ' ' | sed 's/ $//')
if [ "$installed" != "$in_pages" ]; then
  echo "the pages ask jsDelivr for PGlite ${in_pages:-(none)}, but node_modules has $installed" >&2
  exit 1
fi
echo "PGlite $installed, from jsDelivr"
